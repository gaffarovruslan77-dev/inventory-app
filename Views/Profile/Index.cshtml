@model InventoryApp.Web.Controllers.ProfileController.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    string T(string en, string ru)
    {
        var lang = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
        return lang == "ru" ? ru : en;
    }
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center">
        @if (!string.IsNullOrEmpty(Model.User.AvatarUrl))
        {
            <img src="@Model.User.AvatarUrl" alt="avatar" class="rounded-circle me-3" style="width:48px;height:48px;" />
        }
        <div>
            <h2 class="mb-0">@T("Profile","Профиль")</h2>
            <div class="text-muted">@Model.User.DisplayName (@Model.User.Email)</div>
        </div>
    </div>
    @if (ViewBag.ShowAddToCrm == true)
    {
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#crmModal">
            @T("Add to CRM","Добавить в CRM")
        </button>
    }
</div>

@if (ViewBag.ShowAddToCrm == true)
{
    @Html.AntiForgeryToken()
    <div class="modal fade" id="crmModal" tabindex="-1" aria-labelledby="crmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="crmModalLabel">@T("Add to Salesforce CRM","Добавить в Salesforce CRM")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@T("Creates an Account (company) and a Contact linked to your profile email.","Создаётся Account (компания) и Contact, привязанный к email вашего профиля.")</p>
                    <div class="mb-2">
                        <label class="form-label" for="crmCompany">@T("Company","Компания") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="crmCompany" required maxlength="255" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="crmPhone">@T("Phone","Телефон")</label>
                        <input type="text" class="form-control" id="crmPhone" maxlength="40" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="crmJobTitle">@T("Job title","Должность")</label>
                        <input type="text" class="form-control" id="crmJobTitle" maxlength="128" />
                    </div>
                    <div id="crmError" class="alert alert-danger d-none" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T("Cancel","Отмена")</button>
                    <button type="button" class="btn btn-primary" id="crmSubmit">@T("Submit","Отправить")</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-2">@T("My inventories","Мои инвентари")</h5>
        <a class="btn btn-primary btn-sm" href="/Inventory/Create">@T("+ New inventory","+ Новый инвентарь")</a>
    </div>
    <input class="form-control form-control-sm mb-2" id="ownedFilter" placeholder="@T("Filter...","Фильтр...")" />
    <table class="table table-hover" id="ownedTable">
        <thead>
            <tr>
                <th data-col="title" style="cursor:pointer">@T("Title","Название")</th>
                <th data-col="created" style="cursor:pointer">@T("Created","Создан")</th>
                <th data-col="public" style="cursor:pointer">@T("Public","Публичный")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.OwnedInventories)
            {
                <tr style="cursor:pointer" onclick="window.location='/Inventory/Details/@inv.Id'">
                    <td>@inv.Title</td>
                    <td data-sort="@inv.CreatedAt.Ticks">@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(inv.IsPublic ? "✓" : "")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mb-4">
    <h5 class="mb-2">@T("Inventories I can write to","Инвентари с доступом на запись")</h5>
    <input class="form-control form-control-sm mb-2" id="writableFilter" placeholder="@T("Filter...","Фильтр...")" />
    <table class="table table-hover" id="writableTable">
        <thead>
            <tr>
                <th data-col="title" style="cursor:pointer">@T("Title","Название")</th>
                <th data-col="created" style="cursor:pointer">@T("Created","Создан")</th>
                <th data-col="public" style="cursor:pointer">@T("Public","Публичный")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.WritableInventories)
            {
                <tr style="cursor:pointer" onclick="window.location='/Inventory/Details/@inv.Id'">
                    <td>@inv.Title</td>
                    <td data-sort="@inv.CreatedAt.Ticks">@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(inv.IsPublic ? "✓" : "")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
function setupTable(tableId, filterId) {
    const table = document.getElementById(tableId);
    const filter = document.getElementById(filterId);
    if (!table || !filter) return;

    filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        table.querySelectorAll('tbody tr').forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });

    let asc = true;
    table.querySelectorAll('thead th').forEach(th => {
        th.addEventListener('click', () => {
            const idx = Array.from(th.parentElement.children).indexOf(th);
            const rows = Array.from(table.querySelectorAll('tbody tr'));
            rows.sort((a,b) => {
                const ac = a.children[idx].getAttribute('data-sort') ?? a.children[idx].textContent;
                const bc = b.children[idx].getAttribute('data-sort') ?? b.children[idx].textContent;
                return asc ? ac.localeCompare(bc) : bc.localeCompare(ac);
            });
            asc = !asc;
            const tbody = table.querySelector('tbody');
            rows.forEach(r => tbody.appendChild(r));
        });
    });
}

setupTable('ownedTable', 'ownedFilter');
setupTable('writableTable', 'writableFilter');

(function () {
    const submitBtn = document.getElementById('crmSubmit');
    if (!submitBtn) return;
    const tokenInput = document.querySelector('input[name=__RequestVerificationToken]');
    const errEl = document.getElementById('crmError');
    const modalEl = document.getElementById('crmModal');

    submitBtn.addEventListener('click', async () => {
        const company = document.getElementById('crmCompany')?.value?.trim() || '';
        const phone = document.getElementById('crmPhone')?.value?.trim() || '';
        const jobTitle = document.getElementById('crmJobTitle')?.value?.trim() || '';
        errEl.classList.add('d-none');
        errEl.textContent = '';
        if (!company) {
            errEl.textContent = '@T("Company is required.","Укажите компанию.")';
            errEl.classList.remove('d-none');
            return;
        }
        submitBtn.disabled = true;
        try {
            const res = await fetch('@Url.Action("AddToCrm", "Profile")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': tokenInput?.value || ''
                },
                body: JSON.stringify({ company, phone, jobTitle })
            });
            const data = await res.json().catch(() => ({}));
            if (data.success) {
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal?.hide();
                document.getElementById('crmCompany').value = '';
                document.getElementById('crmPhone').value = '';
                document.getElementById('crmJobTitle').value = '';
                alert('@T("Added to CRM successfully.","Успешно добавлено в CRM.")');
            } else {
                errEl.textContent = data.error || '@T("Request failed.","Ошибка запроса.")';
                errEl.classList.remove('d-none');
            }
        } catch {
            errEl.textContent = '@T("Network error.","Сетевая ошибка.")';
            errEl.classList.remove('d-none');
        } finally {
            submitBtn.disabled = false;
        }
    });
})();
</script>

